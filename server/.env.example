# Backend environment variables (copy this file to .env and fill in real values).
# .env is git-ignored. Never commit real credentials.

# Port the Express API listens on.
PORT=4000

# development | production | test
NODE_ENV=development

# Frontend origin allowed by CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Local PostgreSQL 16 connection (SECRET). On this machine PostgreSQL 16 listens on port 5433.
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/neostats_project_manager?schema=public"

# JWT signing secret (SECRET). Required: the server refuses to start if it is
# missing, this placeholder, or shorter than 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Session lifetime (JWT + cookie), e.g. 8h, 1d.
JWT_EXPIRES_IN=8h

# bcrypt work factor for password hashes (10-15, default 12).
BCRYPT_ROUNDS=12

# Optional, DEVELOPMENT ONLY: password given to seeded demo accounts by
# `npm run db:seed`. Leave empty to use the documented default (see README).
SEED_DEMO_PASSWORD=
