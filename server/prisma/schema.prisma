// Prisma schema for the NEOSTATS Project Management Platform.
// Docs: https://www.prisma.io/docs/orm/prisma-schema
//
// Phase 1 models: User, Project, ProjectMember.
// Phase 2 models: Task, Comment.
// Phase 3: User.passwordHash + User.tokenVersion (authentication).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Global role of a user across the whole platform.
enum UserRole {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
  VIEWER
}

// Lifecycle of a project. ARCHIVED projects are read-only history.
enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

// Role of a team member INSIDE one project (separate from the global role).
// The project manager is NOT stored here; see Project.managerId.
//   MEMBER: works on the project (in Phase 2: updates their tasks, comments)
//   VIEWER: read-only access to this one project
enum ProjectRole {
  MEMBER
  VIEWER
}

// Workflow state of a task.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  // Always stored trimmed + lowercase (normalized in services and the seed).
  email        String   @unique @db.VarChar(255)
  role         UserRole @default(TEAM_MEMBER)
  // Soft "deactivate" flag (brief: users are deactivated, not deleted).
  isActive     Boolean  @default(true)
  // bcrypt hash (never the plaintext, never returned by the API).
  // Nullable so users created before Phase 3 keep working; a user without a
  // hash simply cannot log in until an Admin sets a password.
  passwordHash String?  @db.VarChar(100)
  // Session invalidation: every login token carries this number. Logout,
  // deactivation and password resets increment it, which makes all tokens
  // issued earlier for this user invalid immediately.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedProjects Project[]       @relation("ProjectManager")
  memberships     ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  comments        Comment[]

  @@index([role])
  @@map("users")
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(120)
  description String        @default("") @db.VarChar(2000)
  status      ProjectStatus @default(ACTIVE)
  // The single source of truth for "who manages this project".
  // Nullable: a project can exist before a manager is assigned.
  managerId   Int?
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  // Set when status becomes ARCHIVED, cleared when un-archived.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members ProjectMember[]
  tasks   Task[]

  @@index([managerId])
  @@index([status])
  @@map("projects")
}

// Join table: which users belong to which project, and with which project role.
model ProjectMember {
  id        Int         @id @default(autoincrement())
  projectId Int
  userId    Int
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  // Deleting a project removes its memberships (no orphans). Users are never
  // hard-deleted, but if one ever were, their memberships go with them.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can be in a project at most once.
  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int          @id @default(autoincrement())
  projectId   Int
  title       String       @db.VarChar(200)
  description String       @default("") @db.VarChar(5000)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  // Calendar date only (no time of day). Optional.
  dueDate     DateTime?    @db.Date
  // Optional: a task can be unassigned. When set, the server guarantees the
  // user is an active TEAM_MEMBER with project role MEMBER in this project.
  assigneeId  Int?
  // Optimistic concurrency: every update must send the version it read and
  // is applied only WHERE id = ? AND version = ?, incrementing it. A stale
  // version matches no row and the API answers 409 VERSION_CONFLICT.
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Deleting a project deletes its tasks (and, through Comment, their comments).
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Users are never hard-deleted; if one were, their tasks become unassigned.
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  authorId  Int
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  // Comments live and die with their task (no orphans).
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("comments")
}
